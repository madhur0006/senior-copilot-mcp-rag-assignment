# Alarm API simulator
ALARM_API_BASE_URL=http://localhost:8000
ALARM_API_TOKEN=demo-token
ALARM_API_CLIENT_ID=alarm-investigation-copilot
ALARM_API_METADATA_TAG=connector

# MCP server (used later when copilot connects)
MCP_SERVER_URL=http://localhost:9000

# OpenAI
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-replace-me
LLM_API_KEY=sk-replace-me
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# RAG (PDF corpus + metadata)
DOCUMENT_PDF_PATH=./rag/documents-pdf
METADATA_PATH=./rag/documents-pdf/metadata.json
VECTOR_STORE_URL=./rag/.index

# Optional: markdown sources (editing only, not used for RAG ingestion)
DOCUMENT_PATH=./rag/documents

# App settings
AUTH_ENABLED=true
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30
RETRY_COUNT=3
TICKETING_API_URL=replace-me
